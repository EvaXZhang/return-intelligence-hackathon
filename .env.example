# Default: user-authorized live Bedrock inference. This creates no AWS resources.
AI_BACKEND=bedrock
AWS_INTEGRATION_ENABLED=true
DEPLOYMENT_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
DB_PATH=data/return_intelligence.db
UPLOAD_DIR=uploads
ARTIFACT_DIR=artifacts
LOG_PATH=logs/application.log
# Business clock (aligned with the seeded synthetic history). Set DEMO_CLOCK=now (or leave it empty) to use the real UTC date.
DEMO_CLOCK=2026-01-15T12:00:00+00:00
# Season is derived from DEMO_CLOCK (Montréal calendar: Nov-Mar WINTER, May-Aug SUMMER, Apr/Sep/Oct TRANSITION).
# Optional explicit override: SUMMER, WINTER or TRANSITION.
# DEMO_SEASON=WINTER

# Offline fallback (set these in the launch command):
# AI_BACKEND=simulated
# AWS_INTEGRATION_ENABLED=false
